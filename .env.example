# Solana settings for BRUT Web. Copy to .env, fill in, then run:
#
#   npm run config -- .env
#
# That writes the values into config/solana.js, the only file the browser
# reads. None of these is a secret: all of them end up in the page. Leave an
# address empty until it really exists.

# mainnet-beta, devnet or testnet
SOLANA_NETWORK=mainnet-beta

# JSON RPC endpoint. It must allow browser requests, which the Solana
# Foundation endpoint (api.mainnet-beta.solana.com) refuses. PublicNode works
# but is rate limited and skips token balance lookups; use a dedicated
# provider for production traffic.
SOLANA_RPC_URL=https://solana-rpc.publicnode.com

# Solana Explorer root. The cluster is added to each link automatically.
EXPLORER_BASE_URL=https://explorer.solana.com

# BRUT program id. Empty while no BRUT program is deployed.
BRUT_PROGRAM_ID=

# BRUT SPL token mint. Empty until the token exists.
BRUT_TOKEN_MINT=

# Protocol treasury public key. Empty until there is one.
TREASURY_ADDRESS=
